{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/producto/([A-Za-z0-9_-]{1,200})/?",
      "dest": "/api/product-page?id=$1"
    },
    {
      "src": "/pedido/.*",
      "headers": {
        "Referrer-Policy": "no-referrer",
        "X-Robots-Tag": "noindex, nofollow"
      },
      "dest": "/index.html"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance",
      "schedule": "0 3 * * *"
    }
  ]
}
