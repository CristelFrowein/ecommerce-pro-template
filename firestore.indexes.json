rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.token.admin == true; }

    match /products/{id} {
      allow get: if admin() || !('active' in resource.data) || resource.data.active == true;
      allow list: if admin() || resource.data.active == true;
      allow create: if admin() && request.resource.data.get('heldUnits', 0) == 0;
      allow update: if admin()
        && request.resource.data.get('heldUnits', 0) == resource.data.get('heldUnits', 0)
        && (resource.data.get('heldUnits', 0) == 0 ||
          request.resource.data.get('variants', []) == resource.data.get('variants', []));
      allow delete: if admin() && resource.data.get('heldUnits', 0) == 0;
    }
    match /categories/{id} { allow read: if true; allow write: if admin(); }
    match /banners/{id} { allow read: if true; allow write: if admin(); }
    match /storeSettings/{id} { allow read, write: if admin(); }
    match /orders/{id} {
      allow read: if admin();
      match /payments/{paymentId} { allow read: if admin(); }
    }
  }
}
